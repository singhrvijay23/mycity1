DATABASE_URL=postgres://mycity:mycity@localhost:5432/mycity
JWT_SECRET=change-me
PORT=4000
# In development the OTP is always 123456. Set OTP_DEV_MODE=false and wire an SMS provider for production.
OTP_DEV_MODE=true

# Photo storage. "local" keeps files in UPLOAD_DIR (development). Use "s3" in production with any
# S3-compatible bucket (AWS S3, DigitalOcean Spaces, Cloudflare R2, MinIO). Keep the bucket private.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_API_URL=http://localhost:4000
# S3_BUCKET=mycity-photos
# S3_REGION=ap-south-1
# S3_ENDPOINT=            # only for non-AWS providers, e.g. https://blr1.digitaloceanspaces.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
