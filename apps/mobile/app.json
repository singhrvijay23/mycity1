{
  "expo": {
    "name": "MyCity",
    "slug": "mycity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.mycity.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.mycity.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "http://localhost:4000"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "MyCity needs your photos so you can attach them to requirements and quotations.",
          "cameraPermission": "MyCity uses the camera so you can photograph the work or item you need."
        }
      ],
      "expo-secure-store"
    ]
  }
}